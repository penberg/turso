# CHAR(n1, n2, ...) conformance.
#
# CHAR builds a string from the character codes of its integer arguments. The
# front-end builds each code as `CASE WHEN code IS NULL THEN '' ELSE char(code)
# END` and concatenates them, which is exact for the ASCII and control-character
# codes that are the common use (e.g. CHAR(10) newline, CHAR(72, 73) -> 'HI') and
# skips NULL arguments as MySQL does. Each code is coerced to an integer the way
# CAST(... AS SIGNED) is, so a numeric code rounds and a string parses its leading
# integer, matching MySQL.
#
# One divergence, not exercised here: for codes above 127 MySQL emits raw bytes
# (one number can span several) while the engine emits a single UTF-8 code point.
# The CHAR(... USING charset) form is parsed and the charset ignored.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

# Printable ASCII codes build the corresponding string.
query
SELECT CHAR(72, 73), CHAR(65, 66, 67), CHAR(105)
----
HI	ABC	i

# Digits, and a single punctuation code.
query
SELECT CHAR(48, 49, 50), CHAR(124)
----
012	|

# A fractional code rounds (65.9 -> 66 -> 'B', 97.5 -> 98 -> 'b').
query
SELECT CHAR(65.9, 66.4), CHAR(65.4), CHAR(97.5)
----
BB	A	b

# A string code parses its leading integer ('66' -> 66, '66.9' -> 66).
query
SELECT CHAR('66'), CHAR('66.9'), CHAR('72', '73')
----
B	B	HI

# Control characters are produced as single bytes (checked by length to avoid
# embedding them): tab, newline, carriage return.
query
SELECT LENGTH(CHAR(10)), LENGTH(CHAR(9, 10, 13))
----
1	3

# A NULL code is skipped, not turned into a NUL byte: CHAR(65, NULL, 66) is
# 'AB', and an all-NULL CHAR is the empty string (length 0), not a NUL run.
query
SELECT CHAR(65, NULL, 66), HEX(CHAR(72, NULL, NULL, 73)), CHAR(NULL) = '', LENGTH(CHAR(NULL, NULL))
----
AB	4849	1	0

# Skipping holds mid-expression and with all-but-one NULL.
query
SELECT CONCAT('[', CHAR(65, NULL, 66), ']'), CHAR(NULL, 67, NULL)
----
[AB]	C

# CHAR composes with CONCAT (here joining with code 124, a pipe).
query
SELECT CONCAT('a', CHAR(124), 'b')
----
a|b

# Round-trips against a string literal.
query
SELECT CHAR(104, 105) = 'hi'
----
1

# Usable over a column.
statement ok
CREATE TABLE IF NOT EXISTS char_demo (id INT PRIMARY KEY, code INT)

statement ok
INSERT INTO char_demo (id, code) VALUES (1, 88), (2, 89), (3, 90)

query
SELECT id, CHAR(code) FROM char_demo ORDER BY id
----
1	X
2	Y
3	Z
