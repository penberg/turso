# The TRUNCATE(x, d) numeric function.
#
# TRUNCATE truncates x to d decimal places toward zero (distinct from ROUND).
# The engine's trunc only truncates to an integer, so the front-end lowers
# TRUNCATE(x, d) to trunc(x * pow(10, d)) / pow(10, d). A negative d truncates
# left of the decimal point (TRUNCATE(1234.5678, -2) = 1200), and NULL in either
# argument propagates.
#
# Results are asserted via comparisons: the engine renders the result as a plain
# double where MySQL prints a fixed-scale DECIMAL, but the value is equal on both
# targets. Passes against both turso-mysql-server and a real mysqld. Uses its own
# table name.

# Positive, zero, and negative decimal places; truncation is toward zero (not
# rounding -- 3.14159 truncated to 2 places is 3.14, and 3.99 is 3.9).
query
SELECT TRUNCATE(3.14159, 2) = 3.14, TRUNCATE(3.99, 1) = 3.9, TRUNCATE(3.14159, 0) = 3, TRUNCATE(1234.5678, -2) = 1200
----
1	1	1	1

# Negative values truncate toward zero, not down.
query
SELECT TRUNCATE(-3.99, 1) = -3.9, TRUNCATE(-3.14159, 2) = -3.14
----
1	1

# TRUNCATE differs from ROUND (which would round 3.99 to 4.0).
query
SELECT TRUNCATE(3.99, 0) = 3, ROUND(3.99, 0) = 4
----
1	1

# NULL in either argument propagates.
query
SELECT TRUNCATE(NULL, 2) IS NULL, TRUNCATE(3.14, NULL) IS NULL
----
1	1

# Usable over a column.
statement ok
CREATE TABLE IF NOT EXISTS trunct (id INT PRIMARY KEY, v DECIMAL(8,4))

statement ok
INSERT INTO trunct (id, v) VALUES (1, 3.1459), (2, 9.8765)

query
SELECT id FROM trunct WHERE TRUNCATE(v, 2) = 3.14
----
1
