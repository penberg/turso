# Logarithm functions LOG / LOG2 / LOG10 and the constant PI().
#
# MySQL's one-argument LOG(x) is the NATURAL logarithm, so the front-end lowers
# it to the engine's ln(x) (the engine's own one-argument log is base-10). The
# two-argument LOG(b, x) is the base-b logarithm, identical on both. LOG2 / LOG10
# and PI() map straight onto the engine's same-named ones.
#
# Log results are compared after ROUND(): the engine evaluates the base-10/base-2
# logs through natural logs, so an exact power like LOG10(1000) lands a hair off
# 3 (2.9999...), whereas MySQL returns exactly 3 -- rounding to 6 places agrees
# on both targets. Passes against both turso-mysql-server and a real mysqld.
# This test needs no tables.

# LOG(x) is the natural log: LOG(e) = 1 and LOG(e^2) = 2 (it is NOT base-10,
# which would give ~0.434 for LOG(e)).
query
SELECT ROUND(LOG(EXP(1)), 6) = 1, ROUND(LOG(EXP(2)), 6) = 2
----
1	1

# LOG(b, x) is the base-b logarithm.
query
SELECT ROUND(LOG(2, 8), 6) = 3, ROUND(LOG(10, 1000), 6) = 3, ROUND(LOG(3, 9), 6) = 2
----
1	1	1

# LOG2 / LOG10.
query
SELECT ROUND(LOG2(8), 6) = 3, ROUND(LOG10(1000), 6) = 3, ROUND(LOG10(100), 6) = 2
----
1	1	1

# PI() is the constant (~3.14159265).
query
SELECT ROUND(PI(), 5) = 3.14159, PI() > 3.1415 AND PI() < 3.1416
----
1	1

# NULL propagates through each.
query
SELECT LOG(NULL) IS NULL, LOG(2, NULL) IS NULL, LOG2(NULL) IS NULL, LOG10(NULL) IS NULL
----
1	1	1	1
