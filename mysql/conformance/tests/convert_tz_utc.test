# CONVERT_TZ with the named zones 'UTC' / 'GMT' / 'SYSTEM'.
#
# CONVERT_TZ(dt, from_tz, to_tz) shifts a datetime between time zones. The
# front-end lowers it to numeric ±HH:MM-offset arithmetic, so a numeric offset
# works but a named zone yielded NULL. The front-end now normalizes the zones the
# engine resolves to UTC -- 'UTC' / 'GMT' (universal, available without the
# optional time-zone tables) and 'SYSTEM' (the server's own zone, which is UTC for
# this engine and the value @@time_zone reports) -- to the +00:00 offset, so
# `CONVERT_TZ(dt, '+00:00', @@time_zone)` also works.
#
# (Other named zones like 'America/New_York' still need the time-zone tables the
# engine lacks, so they remain NULL; not exercised here. The conformance MySQL
# container's system time zone is UTC.) Expected to pass against both
# turso-mysql-server and a real mysqld.

# UTC -> UTC is the identity.
query
SELECT CONVERT_TZ('2024-06-15 12:00:00', 'UTC', 'UTC')
----
2024-06-15 12:00:00

# Named UTC on either side combines with a numeric offset.
query
SELECT CONVERT_TZ('2024-06-15 12:00:00', 'UTC', '+02:00')
----
2024-06-15 14:00:00

query
SELECT CONVERT_TZ('2024-06-15 12:00:00', '+05:30', 'UTC')
----
2024-06-15 06:30:00

# 'GMT' is equivalent, and the zone name is case-insensitive.
query
SELECT CONVERT_TZ('2024-06-15 12:00:00', 'gmt', '+05:30')
----
2024-06-15 17:30:00

# A plain numeric-offset conversion still works.
query
SELECT CONVERT_TZ('2024-06-15 12:00:00', '+00:00', '-08:00')
----
2024-06-15 04:00:00

# 'SYSTEM' (the engine's UTC server zone) combines with a numeric offset.
query
SELECT CONVERT_TZ('2024-06-15 12:00:00', 'SYSTEM', '+02:00')
----
2024-06-15 14:00:00

# The @@time_zone session variable folds to 'SYSTEM', so converting to/from it
# works -- here a no-op since both sides resolve to UTC.
query
SELECT CONVERT_TZ('2024-06-15 12:00:00', '+00:00', @@time_zone)
----
2024-06-15 12:00:00

# 'SYSTEM' to 'UTC' is the identity (both resolve to +00:00).
query
SELECT CONVERT_TZ('2024-06-15 12:00:00', 'system', 'utc')
----
2024-06-15 12:00:00
