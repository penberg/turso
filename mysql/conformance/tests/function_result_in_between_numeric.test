# A function result in an all-numeric IN list / BETWEEN range is coerced.
#
# MySQL coerces a string operand to a number when comparing it to a number, so
# `DATE_FORMAT(post_date, '%H') IN (9, 12)` matches and `... BETWEEN 9.0 AND
# 13.0` matches by value. The engine compares a string and a number by type, so
# the string DATE_FORMAT result never matched a numeric IN member or range bound.
# An earlier fix handled the binary comparison operators; this extends it to IN
# and BETWEEN, which WP_Date_Query also emits (an hour-set filter is `IN (...)`,
# a time range is `BETWEEN`).
#
# As with the binary-operator case, only a function operand is coerced (a bare
# column is not, to preserve index use), and only when every list member / both
# bounds are numeric literals, so a string IN list still folds ASCII case.
# Expected to pass against both turso-mysql-server and a real mysqld.

# A function result IN an all-numeric list coerces to a number.
query
SELECT DATE_FORMAT('2024-06-17 12:30:45', '%H') IN (10, 11, 12), DATE_FORMAT('2024-06-17 12:30:45', '%H') IN (10, 11)
----
1	0

# NOT IN, and BETWEEN with numeric bounds.
query
SELECT DATE_FORMAT('2024-06-17 09:05:03', '%H') NOT IN (12, 13), DATE_FORMAT('2024-06-17 12:30:45', '%H.%i%s') BETWEEN 12.0 AND 13.0
----
1	1

query
SELECT DATE_FORMAT('2024-06-17 09:05:03', '%H') NOT BETWEEN 12.0 AND 13.0
----
1

# A string IN list still folds ASCII case (the operand is not numeric-coerced
# when the members are strings).
query
SELECT 'b' IN ('A', 'B', 'C'), 'M' BETWEEN 'a' AND 'z'
----
1	1

# The WP_Date_Query shapes against a real column.
statement ok
CREATE TABLE dqib (ID INT PRIMARY KEY, post_date DATETIME)

statement ok
INSERT INTO dqib VALUES (1, '2024-06-17 12:30:45'), (2, '2024-06-17 09:05:03'), (3, '2024-06-18 22:15:00')

query
SELECT ID FROM dqib WHERE DATE_FORMAT(post_date, '%H') IN (9, 12) ORDER BY ID
----
1
2

query
SELECT ID FROM dqib WHERE DATE_FORMAT(post_date, '%H.%i%s') BETWEEN 9.0 AND 13.0 ORDER BY ID
----
1
2
