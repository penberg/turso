# Logical XOR operator conformance.
#
# MySQL's `a XOR b` is the boolean exclusive-or: 1 when exactly one operand is
# truthy, 0 otherwise, and NULL if either operand is NULL. It sits between OR and
# AND in precedence. The engine has no XOR, so the front-end lowers it to
# `(a <> 0) <> (b <> 0)`, which is 1 when exactly one side is non-zero and
# propagates NULL through the outer comparison.
#
# Scope: numeric / boolean operands. A non-numeric string's truthiness diverges
# (the engine does not coerce it to 0) and is not exercised.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

# Exactly one truthy operand gives 1; both or neither give 0.
query
SELECT 1 XOR 0, 0 XOR 1, 1 XOR 1, 0 XOR 0
----
1	1	0	0

# Any non-zero value is truthy.
query
SELECT 5 XOR 0, 5 XOR 3
----
1	0

# NULL in either operand gives NULL.
query
SELECT 1 XOR NULL, NULL XOR NULL
----
NULL	NULL

# Boolean conditions as operands.
query
SELECT (1 = 1) XOR (2 = 3), (1 = 1) XOR (2 = 2)
----
1	0

# Left-associative: 1 XOR 1 XOR 1 = (1 XOR 1) XOR 1 = 1.
query
SELECT 1 XOR 1 XOR 1
----
1

# Precedence: AND binds tighter than XOR, which binds tighter than OR.
query
SELECT 1 XOR 1 AND 0, 1 OR 0 XOR 1
----
1	1

# Usable in WHERE: rows where exactly one predicate holds.
statement ok
CREATE TABLE IF NOT EXISTS lxor_demo (id INT PRIMARY KEY, a INT, b INT)

statement ok
INSERT INTO lxor_demo (id, a, b) VALUES (1, 1, 0), (2, 0, 1), (3, 1, 1), (4, 0, 0)

query
SELECT id FROM lxor_demo WHERE (a = 1) XOR (b = 1) ORDER BY id
----
1
2
