# GREATEST / LEAST conformance.
#
# MySQL's GREATEST(...) / LEAST(...) return the largest / smallest of their
# arguments. The front-end lowers them to a balanced reduction of pairwise
# CASE comparisons under COLLATE NOCASE, so a string comparison folds ASCII case
# like MySQL's default collation (GREATEST('apple', 'Banana') is 'Banana', not
# 'apple') while numbers still compare numerically. Like MySQL, the result is
# NULL if ANY argument is NULL (distinct from the aggregate MAX()/MIN(), which
# skip NULLs).
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name and ORDER BY-deterministic queries.

statement ok
CREATE TABLE IF NOT EXISTS gl_demo (id INT PRIMARY KEY, a INT, b INT, c INT)

statement ok
INSERT INTO gl_demo (id, a, b, c) VALUES (1, 3, 1, 2), (2, 10, 20, 15), (3, 5, 5, 5)

# Numeric literals: largest and smallest.
query
SELECT GREATEST(3, 1, 2), LEAST(3, 1, 2)
----
3	1

# String arguments compare lexically.
query
SELECT GREATEST('apple', 'banana', 'cherry'), LEAST('apple', 'banana', 'cherry')
----
cherry	apple

# The string comparison is case-insensitive (MySQL's default collation): 'Banana'
# sorts after 'apple', so it is the greatest even though 'B' < 'a' by byte value.
query
SELECT GREATEST('apple', 'Banana'), LEAST('apple', 'Banana'), GREATEST('Zebra', 'apple', 'Mango')
----
Banana	apple	Zebra

# Any NULL argument yields NULL (unlike the aggregate MAX/MIN, which skip NULLs).
query
SELECT GREATEST(1, NULL, 3), LEAST(1, NULL, 3)
----
NULL	NULL

# Column form across three columns, ORDER BY-deterministic.
query
SELECT id, GREATEST(a, b, c), LEAST(a, b, c) FROM gl_demo ORDER BY id
----
1	3	1
2	20	10
3	5	5

# Usable in a WHERE predicate.
query
SELECT id FROM gl_demo WHERE GREATEST(a, b, c) >= 20 ORDER BY id
----
2
