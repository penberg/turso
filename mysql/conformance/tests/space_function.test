# SPACE(n) conformance.
#
# MySQL's SPACE(n) returns a string of n spaces; it is exactly REPEAT(' ', n).
# The front-end lowers it the same way as REPEAT: replace(hex(zeroblob(n)), '00',
# ' '). A non-positive n gives the empty string and a NULL n gives NULL.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name; results are bracketed with CONCAT so the spaces and empty
# strings are visible.

# A run of spaces (bracketed so it is visible).
query
SELECT CONCAT('[', SPACE(3), ']')
----
[   ]

# The length matches the requested count.
query
SELECT LENGTH(SPACE(5))
----
5

# A zero or negative count gives the empty string.
query
SELECT CONCAT('[', SPACE(0), ']'), CONCAT('[', SPACE(-2), ']')
----
[]	[]

# A NULL count gives NULL.
query
SELECT SPACE(NULL)
----
NULL

# SPACE(n) agrees with REPEAT(' ', n).
query
SELECT SPACE(4) = REPEAT(' ', 4)
----
1

# Usable over a column, and composes with TRIM.
statement ok
CREATE TABLE IF NOT EXISTS spacefn_demo (id INT PRIMARY KEY, pad INT)

statement ok
INSERT INTO spacefn_demo (id, pad) VALUES (1, 2), (2, 4)

query
SELECT id, LENGTH(CONCAT(SPACE(pad), 'x')) FROM spacefn_demo ORDER BY id
----
1	3
2	5
