# Aggregate + GROUP BY / HAVING conformance.
#
# COUNT / SUM / MIN / MAX over integers, plus GROUP BY and HAVING, have
# identical MySQL and SQLite/turso semantics, so this file must pass against
# both `turso-mysql-server` and a real mysqld. AVG is excluded (its DECIMAL
# formatting diverges). Integer columns are used so SUM renders identically;
# every grouped query uses ORDER BY for determinism.

statement ok
CREATE TABLE IF NOT EXISTS agg_demo (id INT PRIMARY KEY, cat VARCHAR(8), n INT)

statement ok
INSERT INTO agg_demo (id, cat, n) VALUES (1, 'a', 10), (2, 'a', 20), (3, 'b', 5), (4, 'b', 5), (5, 'c', 7)

# Whole-table aggregates (no GROUP BY).
query
SELECT COUNT(*) FROM agg_demo
----
5

query
SELECT SUM(n) FROM agg_demo
----
47

query
SELECT MIN(n), MAX(n) FROM agg_demo
----
5	20

# Grouped aggregates.
query
SELECT cat, COUNT(*), SUM(n) FROM agg_demo GROUP BY cat ORDER BY cat
----
a	2	30
b	2	10
c	1	7

query
SELECT cat, MIN(n), MAX(n) FROM agg_demo GROUP BY cat ORDER BY cat
----
a	10	20
b	5	5
c	7	7

# GROUP BY with a HAVING filter on an aggregate.
query
SELECT cat, COUNT(*) FROM agg_demo GROUP BY cat HAVING COUNT(*) > 1 ORDER BY cat
----
a	2
b	2

# COUNT of a column (counts non-NULL values).
query
SELECT COUNT(n) FROM agg_demo
----
5

# A GROUP BY column ordinal references the output column by position, like
# `ORDER BY 1`: `GROUP BY 1` groups by `cat` (the first select item).
query
SELECT cat, SUM(n) FROM agg_demo GROUP BY 1 ORDER BY 1
----
a	30
b	10
c	7

# Ordinals compose with HAVING and a trailing ORDER BY ordinal.
query
SELECT cat, COUNT(*) FROM agg_demo GROUP BY 1 HAVING COUNT(*) > 1 ORDER BY 1
----
a	2
b	2

# Multiple ordinals, and an ordinal mixed with a column name, group by both.
query
SELECT cat, n, COUNT(*) FROM agg_demo GROUP BY 1, 2 ORDER BY 1, 2
----
a	10	1
a	20	1
b	5	2
c	7	1

query
SELECT cat, n, COUNT(*) FROM agg_demo GROUP BY cat, 2 ORDER BY 1, 2
----
a	10	1
a	20	1
b	5	2
c	7	1

# A non-bare-integer GROUP BY term is an ordinary expression, not an ordinal:
# `GROUP BY n * 1` groups by the value, not the first column.
query
SELECT n * 1 AS v, COUNT(*) FROM agg_demo GROUP BY n * 1 ORDER BY 1
----
5	2
7	1
10	1
20	1
