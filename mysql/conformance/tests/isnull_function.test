# ISNULL(x) conformance.
#
# MySQL's ISNULL(x) returns 1 if x is NULL and 0 otherwise. The front-end lowers
# it to the `x IS NULL` predicate, which the engine evaluates to the same 1/0.
# (This is the single-argument test function, distinct from the two-argument
# IFNULL(x, y) fallback.)
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

# 1 for NULL, 0 for any non-NULL value (including empty string and zero).
query
SELECT ISNULL(NULL), ISNULL(5), ISNULL(''), ISNULL(0)
----
1	0	0	0

# Works on expressions that evaluate to NULL.
query
SELECT ISNULL(1 + NULL), ISNULL(NULLIF(3, 3))
----
1	1

# Usable as a boolean in WHERE and over a column.
statement ok
CREATE TABLE IF NOT EXISTS isnull_demo (id INT PRIMARY KEY, v INT)

statement ok
INSERT INTO isnull_demo (id, v) VALUES (1, 10), (2, NULL), (3, 0)

query
SELECT id, ISNULL(v) FROM isnull_demo ORDER BY id
----
1	0
2	1
3	0

# A NULL-only column filtered with ISNULL.
query
SELECT id FROM isnull_demo WHERE ISNULL(v) ORDER BY id
----
2
