# Bitwise AND (&) and OR (|) operator conformance.
#
# MySQL's `&` and `|` are mapped to the engine's bitwise AND/OR. MySQL evaluates
# them on unsigned 64-bit integers and the engine on signed, so a result with
# bit 63 set would print differently; for the small non-negative operands used
# for flag masks (the common case) the results match. `&` binds tighter than `|`,
# and both bind tighter than the comparison operators but looser than `+`/`-`,
# as in MySQL. (Unary `~`, `^` XOR, and the `<<`/`>>` shifts are not modeled.)
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

# Basic AND / OR.
query
SELECT 5 & 3, 5 | 2, 12 & 10, 12 | 3
----
1	7	8	15

# OR chains and a flag-set build-up.
query
SELECT 1 | 2 | 4 | 8
----
15

# `&` binds tighter than `|`: 8 & 4 | 1 = (8 & 4) | 1 = 0 | 1 = 1.
query
SELECT 8 & 4 | 1
----
1

# Bitwise binds looser than `+`/`-`: 2 + 1 & 3 = (2 + 1) & 3 = 3.
query
SELECT 2 + 1 & 3, 2 + (1 & 3)
----
3	3

# Bitwise binds tighter than comparison: 7 & 3 = 3 is (7 & 3) = 3, which is true.
query
SELECT 7 & 3 = 3
----
1

# NULL propagates through both operators.
query
SELECT 5 & NULL, NULL | 2
----
NULL	NULL

# A flag-mask test in WHERE, the common use (rows whose flag bit 2 is set).
statement ok
CREATE TABLE IF NOT EXISTS bitw_demo (id INT PRIMARY KEY, flags INT)

statement ok
INSERT INTO bitw_demo (id, flags) VALUES (1, 1), (2, 6), (3, 4), (4, 3)

query
SELECT id FROM bitw_demo WHERE flags & 4 ORDER BY id
----
2
3

query
SELECT id, flags | 1 FROM bitw_demo ORDER BY id
----
1	1
2	7
3	5
4	3
