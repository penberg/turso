# Additional scalar string functions whose MySQL and SQLite/turso semantics are
# identical: REPLACE, SUBSTR, TRIM, LTRIM, RTRIM. They share both name and
# behaviour, so they pass straight through to the engine. (INSTR/LOCATE are
# MySQL-case-insensitive and are lowered separately — see instr_locate.test.)
#
# (CONCAT and LENGTH are intentionally excluded — they diverge: CONCAT returns
# NULL if any argument is NULL, and LENGTH counts bytes in MySQL but characters
# in SQLite. See mysql/COMPAT.md.)
#
# Expected to pass against both turso-mysql-server and a real mysqld.

# REPLACE replaces every occurrence, case-sensitively, on both.
query
SELECT REPLACE('a-b-c-b', '-b', '+B')
----
a+B-c+B

# SUBSTR is 1-indexed with an optional length, on both.
query
SELECT SUBSTR('hello world', 7)
----
world

query
SELECT SUBSTR('hello world', 1, 5)
----
hello

# SUBSTR with a negative position counts from the end, on both.
query
SELECT SUBSTR('hello', -2)
----
lo

# TRIM removes leading and trailing spaces.
query
SELECT TRIM('   padded   ')
----
padded

# LTRIM removes only leading spaces, RTRIM only trailing (bracketed so the kept
# spaces are visible).
query
SELECT CONCAT('[', LTRIM('  left  '), ']'), CONCAT('[', RTRIM('  right  '), ']')
----
[left  ]	[  right]

# LTRIM/RTRIM leave a string with no edge spaces unchanged, and propagate NULL.
query
SELECT LTRIM('none'), RTRIM(NULL)
----
none	NULL

# These functions compose with the existing ones and with WHERE.
query
SELECT UPPER(SUBSTR('hello', 1, 3))
----
HEL
