# Introspection functions in expression context: VERSION / DATABASE /
# CONNECTION_ID / USER / CURRENT_USER.
#
# These return server/connection metadata. The front-end answered a few as
# standalone queries (e.g. `SELECT VERSION()`); this makes them usable inside
# any expression too. Most values are server-specific and the front-end's are
# fixed placeholders (see mysql/COMPAT.md), so these checks assert only portable
# properties that hold on both turso-mysql-server and a real mysqld.

# DATABASE() / SCHEMA() report the connection's current database. The conformance
# connection selects one, so it is non-NULL and the two are the same; it is
# usable mid-expression (here wrapped in LENGTH and an equality).
query
SELECT DATABASE() IS NOT NULL, LENGTH(DATABASE()) > 0, DATABASE() = SCHEMA()
----
1	1	1

# CONNECTION_ID() is a positive integer, usable in a comparison.
query
SELECT CONNECTION_ID() > 0
----
1

# VERSION() and CURRENT_USER() are non-empty and usable mid-expression / list.
query
SELECT LENGTH(VERSION()) > 0, CURRENT_USER() IS NOT NULL
----
1	1
