# The MySQL 8 `TABLE` statement.
#
# `TABLE tbl [ORDER BY ...] [LIMIT ...]` is shorthand for
# `SELECT * FROM tbl [ORDER BY ...] [LIMIT ...]`. The front-end rejected it
# ("TABLE is not supported yet"); it now lowers to exactly that SELECT *.
#
# Expected to pass against both turso-mysql-server and a real mysqld. The
# multi-row cases use ORDER BY for a deterministic order (bare TABLE leaves the
# order unspecified on both). Uses its own table names.

# Bare TABLE on a single-row table.
statement ok
CREATE TABLE IF NOT EXISTS tbs_one (id INT PRIMARY KEY, v VARCHAR(10))

statement ok
INSERT INTO tbs_one (id, v) VALUES (1, 'x')

query
TABLE tbs_one
----
1	x

# TABLE with ORDER BY.
statement ok
CREATE TABLE IF NOT EXISTS tbs (id INT PRIMARY KEY, c INT)

statement ok
INSERT INTO tbs (id, c) VALUES (3, 30), (1, 10), (2, 20)

query
TABLE tbs ORDER BY id
----
1	10
2	20
3	30

# TABLE with ORDER BY ... DESC and LIMIT.
query
TABLE tbs ORDER BY c DESC LIMIT 2
----
3	30
2	20

# TABLE with an offset LIMIT.
query
TABLE tbs ORDER BY id LIMIT 1, 1
----
2	20
