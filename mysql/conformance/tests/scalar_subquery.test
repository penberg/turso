# Scalar subqueries in expressions: (SELECT ...) used as a value.
#
# A parenthesized SELECT returning a single value can be used wherever an
# expression is allowed (SELECT list, WHERE), including correlated subqueries.
# WordPress's WP_Query builds these for tax_query / meta_query counts. The engine
# evaluates them identically to MySQL.
#
# Expected to pass against both turso-mysql-server and a real mysqld.

statement ok
CREATE TABLE IF NOT EXISTS sq_posts (id INT PRIMARY KEY, title VARCHAR(16))

statement ok
CREATE TABLE IF NOT EXISTS sq_rel (post_id INT, tag INT)

statement ok
INSERT INTO sq_posts (id, title) VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
INSERT INTO sq_rel (post_id, tag) VALUES (1, 10), (1, 20), (2, 10)

# Correlated scalar subquery in the SELECT list (a per-row count).
query
SELECT id, (SELECT COUNT(*) FROM sq_rel WHERE sq_rel.post_id = sq_posts.id) FROM sq_posts ORDER BY id
----
1	2
2	1
3	0

# Correlated scalar subquery in WHERE.
query
SELECT id FROM sq_posts WHERE (SELECT COUNT(*) FROM sq_rel WHERE sq_rel.post_id = sq_posts.id) = 2 ORDER BY id
----
1

# Uncorrelated scalar subquery used as a constant.
query
SELECT id FROM sq_posts WHERE id = (SELECT MIN(post_id) FROM sq_rel) ORDER BY id
----
1
