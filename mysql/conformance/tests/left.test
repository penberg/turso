# LEFT(str, len) conformance.
#
# MySQL's LEFT(str, len) returns the leftmost `len` characters of `str`. That is
# exactly the engine's substr(str, 1, len), so the front-end lowers LEFT to it.
# A NULL string yields NULL, len <= 0 yields the empty string, and len past the
# end of the string yields the whole string — all of which substr(str, 1, len)
# reproduces.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Every
# row-returning query is ORDER BY-deterministic. Uses its own table name.

statement ok
CREATE TABLE IF NOT EXISTS left_demo (a INT PRIMARY KEY, b VARCHAR(32))

statement ok
INSERT INTO left_demo (a, b) VALUES (1, 'hello'), (2, 'wordpress'), (3, NULL)

# The leftmost N characters of a literal.
query
SELECT LEFT('hello world', 5)
----
hello

# Column form, ORDER BY-deterministic.
query
SELECT a, LEFT(b, 4) FROM left_demo ORDER BY a
----
1	hell
2	word
3	NULL

# len past the end returns the whole string.
query
SELECT LEFT('abc', 10)
----
abc

# len of zero returns the empty string (wrapped in brackets so the empty result
# is visible — a bare empty row is indistinguishable from "no rows" in the DSL).
query
SELECT CONCAT('[', LEFT('abc', 0), ']')
----
[]

# A NULL length yields NULL.
query
SELECT LEFT('abc', NULL)
----
NULL

# Usable in a WHERE predicate.
query
SELECT a FROM left_demo WHERE LEFT(b, 4) = 'word' ORDER BY a
----
2
