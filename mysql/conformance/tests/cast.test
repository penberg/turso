# CAST(expr AS type) conformance.
#
# MySQL CAST is parsed as a real cast (not a function call) and mapped onto the
# engine's affinity-based CAST. Supported targets: CHAR (text), SIGNED /
# UNSIGNED (integer), DECIMAL / DEC (fixed-point), DOUBLE / FLOAT / REAL (real),
# BINARY (blob). A CHAR(n) length bounds the result to n characters. CAST to DECIMAL
# rounds the value to its scale D (default 0, since bare DECIMAL is
# DECIMAL(10,0)): D = 0 yields an integer, D > 0 keeps D places. The DATE /
# DATETIME / TIME targets are handled separately (lowered to
# date()/datetime()/time()) — see cast_datetime.test.
#
# These cases use integer/string inputs where both targets agree, so they pass
# against both turso-mysql-server and a real mysqld.

statement ok
CREATE TABLE IF NOT EXISTS cast_demo (a INT PRIMARY KEY, b VARCHAR(16))

statement ok
INSERT INTO cast_demo (a, b) VALUES (10, '7'), (2, '30')

# Integer to CHAR (text).
query
SELECT CAST(a AS CHAR) FROM cast_demo ORDER BY a
----
2
10

# String to SIGNED integer: ordering is numeric, not lexical ('30' < '7' as text).
query
SELECT b FROM cast_demo ORDER BY CAST(b AS SIGNED)
----
7
30

# String to UNSIGNED, projected.
query
SELECT CAST(b AS UNSIGNED) FROM cast_demo ORDER BY a
----
30
7

# CHAR with a length that fits leaves the value unchanged (no padding).
query
SELECT CAST(a AS CHAR(4)) FROM cast_demo ORDER BY a
----
2
10

# CHAR(n) truncates the text to n characters, like MySQL — a string is cut to its
# first n characters, and a number is rendered then cut. CHAR(0) yields the empty
# string, and NULL propagates. (CHAR with no length never truncates.)
query
SELECT CAST('abcdef' AS CHAR(3)), CAST(12345 AS CHAR(3)), CAST(123.456 AS CHAR(4))
----
abc	123	123.

query
SELECT CAST('ab' AS CHAR(5)), CAST('abcdef' AS CHAR(0)), CAST(NULL AS CHAR(3)), CAST('keepall' AS CHAR)
----
ab		NULL	keepall

# The truncation composes over a column — `b` is '30' for a=2 and '7' for a=10,
# each cut to its first character.
query
SELECT CAST(b AS CHAR(1)) FROM cast_demo ORDER BY a
----
3
7

# CAST to bare DECIMAL is DECIMAL(10,0): it rounds to an integer (half away from
# zero), parsing a leading-numeric string and treating a non-numeric one as 0.
query
SELECT CAST(123.456 AS DECIMAL), CAST(2.5 AS DECIMAL), CAST(-2.5 AS DECIMAL), CAST('45.67' AS DECIMAL), CAST('abc' AS DECIMAL)
----
123	3	-3	46	0

# DEC is a synonym, and an explicit scale rounds to that many places.
query
SELECT CAST(99.99 AS DEC), CAST(123.456 AS DECIMAL(10,2)), CAST(123.456 AS DECIMAL(10,1)), CONVERT(123.456, DECIMAL(10,2))
----
100	123.46	123.5	123.46

# NULL propagates through the rounding cast.
query
SELECT CAST(NULL AS DECIMAL) IS NULL, CAST(NULL AS DECIMAL(10,2)) IS NULL
----
1	1

# WordPress sorts text meta values numerically with CAST(... AS DECIMAL); the
# rounding cast orders them by value, not lexically.
statement ok
CREATE TABLE cast_meta (id INT PRIMARY KEY, v VARCHAR(16))

statement ok
INSERT INTO cast_meta VALUES (1, '10.5'), (2, '9.99'), (3, '100'), (4, '2')

query
SELECT id FROM cast_meta ORDER BY CAST(v AS DECIMAL(10,2)) ASC
----
4
2
1
3
