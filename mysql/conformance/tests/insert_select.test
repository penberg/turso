# INSERT ... SELECT conformance.
#
# MySQL's INSERT [INTO] tbl [(cols)] SELECT ... populates a table from a query.
# The engine runs this directly, so the front-end parses the SELECT (through the
# same parser as a top-level one) into the insert body. The IGNORE and REPLACE
# conflict modifiers carry through to the SELECT form.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table names and ORDER BY-deterministic queries.

statement ok
CREATE TABLE IF NOT EXISTS isel_src (id INT PRIMARY KEY, name VARCHAR(20), n INT)

statement ok
CREATE TABLE IF NOT EXISTS isel_dst (id INT PRIMARY KEY, name VARCHAR(20), n INT)

statement ok
INSERT INTO isel_src (id, name, n) VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30)

# Column-list form with a WHERE filter and a transformed expression.
statement ok
INSERT INTO isel_dst (id, name, n) SELECT id, name, n FROM isel_src WHERE n >= 20

query
SELECT id, name, n FROM isel_dst ORDER BY id
----
2	b	20
3	c	30

# No column list: the select's columns line up with the table's, and the rows
# may be computed.
statement ok
INSERT INTO isel_dst SELECT id + 10, name, n * 2 FROM isel_src WHERE id = 1

query
SELECT id, name, n FROM isel_dst ORDER BY id
----
2	b	20
3	c	30
11	a	20

# INSERT IGNORE ... SELECT skips rows that would violate the primary key.
statement ok
INSERT IGNORE INTO isel_dst (id, name, n) SELECT id, name, n FROM isel_src

query
SELECT id, name, n FROM isel_dst ORDER BY id
----
1	a	10
2	b	20
3	c	30
11	a	20

# REPLACE ... SELECT overwrites the conflicting rows.
statement ok
REPLACE INTO isel_dst (id, name, n) SELECT id, name, n + 100 FROM isel_src WHERE id IN (2, 3)

query
SELECT id, name, n FROM isel_dst ORDER BY id
----
1	a	10
2	b	120
3	c	130
11	a	20

# A trailing ON DUPLICATE KEY UPDATE on the SELECT form: the query's rows are the
# would-be-inserted values, updating a row that conflicts and inserting one that
# does not -- just like the VALUES form.
statement ok
CREATE TABLE IF NOT EXISTS iseldup_tgt (id INT PRIMARY KEY, v INT)

statement ok
INSERT INTO iseldup_tgt (id, v) VALUES (1, 10), (2, 20)

statement ok
CREATE TABLE IF NOT EXISTS iseldup_src (id INT, v INT)

statement ok
INSERT INTO iseldup_src (id, v) VALUES (1, 100), (3, 30)

# id=1 conflicts (updated to v + 5), id=3 is inserted as-is.
statement ok
INSERT INTO iseldup_tgt (id, v) SELECT id, v FROM iseldup_src ON DUPLICATE KEY UPDATE v = iseldup_tgt.v + 5

query
SELECT id, v FROM iseldup_tgt ORDER BY id
----
1	15
2	20
3	30

# VALUES(col) in the UPDATE is the would-be-inserted value (the SELECT's column).
statement ok
INSERT INTO iseldup_tgt (id, v) SELECT id, v FROM iseldup_src ON DUPLICATE KEY UPDATE v = VALUES(v)

query
SELECT id, v FROM iseldup_tgt ORDER BY id
----
1	100
2	20
3	30

# A literal SELECT (no FROM) with ON DUPLICATE KEY UPDATE also works.
statement ok
INSERT INTO iseldup_tgt (id, v) SELECT 2, 7 ON DUPLICATE KEY UPDATE v = v + 1

query
SELECT v FROM iseldup_tgt WHERE id = 2
----
21
