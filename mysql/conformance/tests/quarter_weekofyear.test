# QUARTER / WEEKOFYEAR conformance.
#
# MySQL's QUARTER(d) returns the 1-4 calendar quarter; the front-end lowers it
# to (CAST(strftime('%m', d) AS INTEGER) + 2) / 3, whose integer division maps
# each month to its quarter. WEEKOFYEAR(d) is the ISO-8601 week (a synonym for
# WEEK(d, 3)), lowered to CAST(strftime('%V', d) AS INTEGER). NULL propagates
# through both.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name and ORDER BY-deterministic queries.

statement ok
CREATE TABLE IF NOT EXISTS qw_demo (a INT PRIMARY KEY, d DATE)

statement ok
INSERT INTO qw_demo (a, d) VALUES
  (1, '2020-01-15'),
  (2, '2020-03-31'),
  (3, '2020-04-01'),
  (4, '2020-09-30'),
  (5, '2020-12-25')

# Each month maps to its quarter; the quarter boundaries (Mar/Apr) are exact.
query
SELECT a, QUARTER(d) FROM qw_demo ORDER BY a
----
1	1
2	1
3	2
4	3
5	4

# WEEKOFYEAR is the ISO week: 2020-01-01 is week 1, and 2021-01-01 belongs to
# ISO week 53 of the previous year.
query
SELECT WEEKOFYEAR('2020-01-01'), WEEKOFYEAR('2021-01-01')
----
1	53

# NULL propagates through both.
query
SELECT QUARTER(NULL), WEEKOFYEAR(NULL)
----
NULL	NULL

# Usable in a WHERE predicate.
query
SELECT a FROM qw_demo WHERE QUARTER(d) = 1 ORDER BY a
----
1
2
