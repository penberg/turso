# REGEXP / RLIKE conformance.
#
# MySQL's REGEXP (and its synonym RLIKE) matches a string against a regular
# expression. The front-end maps it to the engine's REGEXP operator, backed by
# the `regexp` function (the Rust regex crate). MySQL's REGEXP is
# case-insensitive by default; the front-end reproduces that by prepending the
# regex crate's inline `(?i)` flag to the pattern, so matching — including
# character classes — folds case the same way.
#
# Expected to pass against both turso-mysql-server and a real mysqld.

statement ok
CREATE TABLE IF NOT EXISTS re_demo (a INT PRIMARY KEY, b VARCHAR(32))

statement ok
INSERT INTO re_demo (a, b) VALUES (1, 'rss_feed'), (2, 'hello'), (3, 'abc123')

# Anchored prefix match.
query
SELECT a FROM re_demo WHERE b REGEXP '^rss_' ORDER BY a
----
1

# Character class and quantifier.
query
SELECT a FROM re_demo WHERE b REGEXP '[0-9]+' ORDER BY a
----
3

# RLIKE is a synonym for REGEXP.
query
SELECT a FROM re_demo WHERE b RLIKE 'll' ORDER BY a
----
2

# NOT REGEXP negates the match.
query
SELECT a FROM re_demo WHERE b NOT REGEXP '[0-9]' ORDER BY a
----
1
2

# As a boolean expression (1 when the pattern is found).
query
SELECT 'abc' REGEXP 'b'
----
1

# Matching is case-insensitive by default, like MySQL: an uppercase subject
# matches a lowercase pattern and vice versa.
query
SELECT 'ABC' REGEXP 'abc', 'abc' REGEXP 'ABC', 'Hello' REGEXP '^hello$'
----
1	1	1

# Case folding applies inside character classes too, not just literal letters.
query
SELECT 'ABC' REGEXP '[a-c]+', 'XYZ' REGEXP '[a-c]'
----
1	0

# A case-insensitive class match against table data.
statement ok
INSERT INTO re_demo (a, b) VALUES (4, 'WordPress')

query
SELECT a FROM re_demo WHERE b REGEXP 'wordpress' ORDER BY a
----
4

# A NULL pattern yields NULL (propagates through the prepended flag).
query
SELECT 'abc' REGEXP NULL
----
NULL
