# IS [NOT] TRUE / FALSE / UNKNOWN conformance.
#
# MySQL's boolean tests treat any non-zero, non-NULL value as TRUE, zero as
# FALSE, and NULL as UNKNOWN; they always return 1 or 0, never NULL. The
# front-end lowers them:
#   x IS UNKNOWN  -> x IS NULL        (and IS NOT UNKNOWN -> IS NOT NULL)
#   x IS TRUE     -> coalesce(x <> 0, 0)
#   x IS FALSE    -> coalesce(x = 0, 0)
# with the IS NOT forms flipping the comparison and defaulting to 1.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name and ORDER BY-deterministic queries.

# IS TRUE: non-zero is true; zero and NULL are not.
query
SELECT 5 IS TRUE, 0 IS TRUE, NULL IS TRUE
----
1	0	0

# IS FALSE: only zero is false.
query
SELECT 0 IS FALSE, 5 IS FALSE, NULL IS FALSE
----
1	0	0

# IS UNKNOWN is IS NULL.
query
SELECT NULL IS UNKNOWN, 5 IS UNKNOWN
----
1	0

# The IS NOT forms negate, and never yield NULL.
query
SELECT 5 IS NOT TRUE, 0 IS NOT TRUE, NULL IS NOT TRUE
----
0	1	1

query
SELECT 0 IS NOT FALSE, 5 IS NOT FALSE, NULL IS NOT FALSE
----
0	1	1

query
SELECT NULL IS NOT UNKNOWN, 5 IS NOT UNKNOWN
----
0	1

# A comparison result is itself testable: (3 > 1) IS TRUE.
query
SELECT (3 > 1) IS TRUE, (3 < 1) IS TRUE
----
1	0

# IS binds looser than the comparison operators, so a comparison need not be
# parenthesized: `1 = 1 IS TRUE` is `(1 = 1) IS TRUE`. This holds for `=`, `IN`,
# `BETWEEN`, `LIKE`, and the other comparisons.
query
SELECT 1 = 1 IS TRUE, 1 = 2 IS FALSE, 5 > 3 IS TRUE, 5 BETWEEN 1 AND 9 IS TRUE
----
1	1	1	1

query
SELECT 'x' IN ('a', 'b') IS FALSE, 2 IN (1, 2) IS NOT FALSE, 'a' LIKE 'a' IS TRUE
----
1	1	1

# A comparison whose result is NULL is UNKNOWN / IS NULL, and the IS tests chain
# left-to-right: `NULL = 1 IS NULL` is `(NULL = 1) IS NULL`, and `NULL IS NULL IS
# TRUE` is `(NULL IS NULL) IS TRUE`.
query
SELECT NULL = 1 IS NULL, NULL = 1 IS UNKNOWN, NULL IS NULL IS TRUE
----
1	1	1

# In a WHERE predicate over a column with a NULL.
statement ok
CREATE TABLE IF NOT EXISTS tr_demo (id INT PRIMARY KEY, flag INT)

statement ok
INSERT INTO tr_demo (id, flag) VALUES (1, 1), (2, 0), (3, NULL)

query
SELECT id FROM tr_demo WHERE flag IS TRUE ORDER BY id
----
1

query
SELECT id FROM tr_demo WHERE flag IS NOT TRUE ORDER BY id
----
2
3
