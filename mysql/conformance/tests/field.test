# FIELD(value, a, b, c, ...) conformance.
#
# FIELD returns the 1-based index of `value` among the following arguments, or 0
# if it is not found (or NULL). The front-end lowers it to an equivalent CASE
# expression, which the engine evaluates identically. WordPress uses FIELD to
# preserve an explicit ordering — ORDER BY FIELD(ID, ...), as in WP_Query with
# orderby=post__in.
#
# Expected to pass against both turso-mysql-server and a real mysqld.

statement ok
CREATE TABLE IF NOT EXISTS field_demo (id INT PRIMARY KEY, label VARCHAR(8))

statement ok
INSERT INTO field_demo (id, label) VALUES (1, 'a'), (2, 'b'), (3, 'c')

# As a scalar: the 1-based index of the value, or 0 when absent.
query
SELECT FIELD(2, 1, 2, 3), FIELD(3, 1, 2, 3), FIELD(9, 1, 2, 3)
----
2	3	0

# ORDER BY FIELD preserves the explicit order (3, 1, 2).
query
SELECT id FROM field_demo ORDER BY FIELD(id, 3, 1, 2)
----
3
1
2

# Values not in the list sort first (FIELD = 0), then by the tiebreak.
query
SELECT id FROM field_demo ORDER BY FIELD(id, 2), id
----
1
3
2

# Works on strings too.
query
SELECT FIELD('b', 'a', 'b', 'c')
----
2
