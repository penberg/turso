# The STRCMP(a, b) function.
#
# STRCMP compares two strings and returns -1, 0, or 1 for a < b, a = b, a > b,
# and NULL if either argument is NULL. The front-end lowers it to a CASE over the
# `<` / `=` / `>` comparisons.
#
# The comparison uses the engine's binary (case-sensitive) collation, so a result
# for strings differing only in case diverges from MySQL's case-insensitive
# default (`STRCMP('a', 'A')` is 1 here vs 0 on MySQL -- the same collation
# divergence documented in mysql/COMPAT.md). This test uses operands that compare
# the same under both collations, so it passes against both turso-mysql-server
# and a real mysqld. Uses its own table name.

# Ordering of distinct strings.
query
SELECT STRCMP('a', 'b'), STRCMP('b', 'a'), STRCMP('a', 'a'), STRCMP('abc', 'abd')
----
-1	1	0	-1

# A shorter string that is a prefix sorts first; whole-string ordering.
query
SELECT STRCMP('a', 'aa') = -1, STRCMP('apple', 'apple') = 0, STRCMP('text', 'best') = 1
----
1	1	1

# NULL in either argument yields NULL.
query
SELECT STRCMP(NULL, 'x') IS NULL, STRCMP('x', NULL) IS NULL, STRCMP(NULL, NULL) IS NULL
----
1	1	1

# Usable over columns.
statement ok
CREATE TABLE IF NOT EXISTS scmp (id INT PRIMARY KEY, a VARCHAR(20), b VARCHAR(20))

statement ok
INSERT INTO scmp (id, a, b) VALUES (1, 'cat', 'dog'), (2, 'zebra', 'ant'), (3, 'same', 'same')

query
SELECT id, STRCMP(a, b) FROM scmp ORDER BY id
----
1	-1
2	1
3	0
