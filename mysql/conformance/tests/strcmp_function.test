# The STRCMP(a, b) function.
#
# STRCMP compares two strings and returns -1, 0, or 1 for a < b, a = b, a > b,
# and NULL if either argument is NULL. The front-end lowers it to a CASE over the
# `<` / `=` / `>` comparisons, taken under COLLATE NOCASE so it folds ASCII case
# like MySQL's default case-insensitive collation. Expected to pass against both
# turso-mysql-server and a real mysqld. Uses its own table name.

# Ordering of distinct strings.
query
SELECT STRCMP('a', 'b'), STRCMP('b', 'a'), STRCMP('a', 'a'), STRCMP('abc', 'abd')
----
-1	1	0	-1

# A shorter string that is a prefix sorts first; whole-string ordering.
query
SELECT STRCMP('a', 'aa') = -1, STRCMP('apple', 'apple') = 0, STRCMP('text', 'best') = 1
----
1	1	1

# NULL in either argument yields NULL.
query
SELECT STRCMP(NULL, 'x') IS NULL, STRCMP('x', NULL) IS NULL, STRCMP(NULL, NULL) IS NULL
----
1	1	1

# Case is folded (MySQL's default collation is case-insensitive): operands that
# differ only in case are equal.
query
SELECT STRCMP('a', 'A'), STRCMP('abc', 'ABC'), STRCMP('apple', 'Apple')
----
0	0	0

# Case folding still respects letter ordering: 'A' < 'b', 'Z' (folds to 'z') > 'a'.
query
SELECT STRCMP('A', 'b'), STRCMP('B', 'a'), STRCMP('Z', 'a')
----
-1	1	1

# A case-insensitive comparison over a column.
statement ok
CREATE TABLE IF NOT EXISTS scmp_ci (id INT PRIMARY KEY, a VARCHAR(20))

statement ok
INSERT INTO scmp_ci (id, a) VALUES (1, 'Hello'), (2, 'WORLD')

query
SELECT id, STRCMP(a, 'hello'), STRCMP(a, 'world') FROM scmp_ci ORDER BY id
----
1	0	-1
2	1	0

# Usable over columns.
statement ok
CREATE TABLE IF NOT EXISTS scmp (id INT PRIMARY KEY, a VARCHAR(20), b VARCHAR(20))

statement ok
INSERT INTO scmp (id, a, b) VALUES (1, 'cat', 'dog'), (2, 'zebra', 'ant'), (3, 'same', 'same')

query
SELECT id, STRCMP(a, b) FROM scmp ORDER BY id
----
1	-1
2	1
3	0
