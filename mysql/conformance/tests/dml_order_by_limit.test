# DELETE / UPDATE with ORDER BY ... LIMIT.
#
# MySQL's `DELETE FROM t [WHERE ...] ORDER BY ... LIMIT n` deletes the n rows
# that sort first, and `UPDATE t SET ... [WHERE ...] ORDER BY ... LIMIT n`
# updates them. The engine cannot order a DELETE/UPDATE in place, so the
# front-end folds the ordering and row cap into a `rowid IN (SELECT rowid FROM t
# [WHERE ...] ORDER BY ... LIMIT n)` subquery -- which selects exactly the rows
# MySQL would touch, so the observable result matches a real mysqld.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

statement ok
CREATE TABLE IF NOT EXISTS dol (id INT PRIMARY KEY, a INT, g INT)

statement ok
INSERT INTO dol (id, a, g) VALUES (1, 5, 1), (2, 12, 1), (3, 9, 2), (4, 1, 2), (5, 7, 1)

# Delete the two smallest-a rows: a=1 (id 4) and a=5 (id 1).
statement ok
DELETE FROM dol ORDER BY a ASC LIMIT 2

query
SELECT id, a FROM dol ORDER BY id
----
2	12
3	9
5	7

# Delete the single largest-a row among g=1 (a=12, id 2); g=1 also has id 5 (7).
statement ok
DELETE FROM dol WHERE g = 1 ORDER BY a DESC LIMIT 1

query
SELECT id FROM dol ORDER BY id
----
3
5

# Update the smallest-a remaining row (id 5, a=7) to a=100.
statement ok
UPDATE dol SET a = 100 ORDER BY a ASC LIMIT 1

query
SELECT id, a FROM dol ORDER BY id
----
3	9
5	100

# A WHERE plus ORDER BY ... LIMIT updates only matching rows, in order.
statement ok
INSERT INTO dol (id, a, g) VALUES (6, 2, 2), (7, 4, 2)

statement ok
UPDATE dol SET a = 0 WHERE g = 2 ORDER BY a DESC LIMIT 1

query
SELECT id, a FROM dol WHERE g = 2 ORDER BY id
----
3	0
6	2
7	4
