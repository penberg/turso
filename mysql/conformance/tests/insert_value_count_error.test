# INSERT with a wrong value count reports ER_WRONG_VALUE_COUNT_ON_ROW (1136).
#
# When an INSERT row supplies a number of values that does not match the column
# count, MySQL fails with ER_WRONG_VALUE_COUNT_ON_ROW (1136, "Column count
# doesn't match value count at row 1"). The front-end mapped the engine's error
# ("table t has N columns but M values were supplied") to the generic 1105, which
# misleads tools and `$wpdb` that branch on mysql_errno().
#
# Expected to pass against both turso-mysql-server and a real mysqld (the
# `statement error <code>` directive pins the MySQL error number, so the differing
# message text does not matter).

statement ok
CREATE TABLE insvalcnt (id INT PRIMARY KEY, code CHAR(3), n INT)

# Too few values for the table's columns.
statement error 1136
INSERT INTO insvalcnt VALUES (1)

# Too many values.
statement error 1136
INSERT INTO insvalcnt VALUES (1, 'ab', 3, 4)

# A column list whose length does not match the value count.
statement error 1136
INSERT INTO insvalcnt (id, code) VALUES (1)

# A matching value count still inserts.
statement ok
INSERT INTO insvalcnt VALUES (1, 'ab', 3)

# A different error (duplicate primary key) keeps its own code, not 1136.
statement error 1062
INSERT INTO insvalcnt VALUES (1, 'cd', 9)
