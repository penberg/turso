# DATE_FORMAT(d, fmt) conformance.
#
# MySQL's DATE_FORMAT formats a datetime with format specifiers. The front-end
# lowers it to the engine's strftime(), translating the MySQL specifiers that
# have a direct strftime equivalent: %Y %m %d %H, %i (minutes -> %M),
# %s (seconds -> %S), %j (day of year), %w (weekday number), %U (Sunday-first
# week), %v (ISO week -> %V), %T (-> %H:%M:%S), and %%. Literal characters pass
# through. The format must be a string literal; specifiers without a strftime
# equivalent (e.g. %M month name, %p, %W weekday name, %h) are rejected. See
# mysql/COMPAT.md.
#
# Expected to pass against both turso-mysql-server and a real mysqld.

statement ok
CREATE TABLE IF NOT EXISTS df_demo (a INT PRIMARY KEY, d DATETIME)

statement ok
INSERT INTO df_demo (a, d) VALUES (1, '2020-03-15 09:07:42')

# Reconstruct the standard datetime string (%i/%s map to minutes/seconds).
query
SELECT DATE_FORMAT(d, '%Y-%m-%d %H:%i:%s') FROM df_demo
----
2020-03-15 09:07:42

# Custom separators and literal text are copied verbatim.
query
SELECT DATE_FORMAT(d, 'Y=%Y M=%m D=%d') FROM df_demo
----
Y=2020 M=03 D=15

# A literal percent (%%).
query
SELECT DATE_FORMAT(d, '%H%%') FROM df_demo
----
09%

# %j is the day of year, 3-digit zero-padded (2020-03-15 is day 075).
query
SELECT DATE_FORMAT(d, '%j') FROM df_demo
----
075

# %j at the year boundaries.
query
SELECT DATE_FORMAT('2021-01-01', '%j'), DATE_FORMAT('2021-12-31', '%j')
----
001	365

# %w is the weekday number, 0=Sunday..6=Saturday (2020-03-15 is a Sunday).
query
SELECT DATE_FORMAT(d, '%w') FROM df_demo
----
0

query
SELECT DATE_FORMAT('2020-03-16', '%w'), DATE_FORMAT('2020-03-21', '%w')
----
1	6

# %j and %w compose with literal text and other specifiers.
query
SELECT DATE_FORMAT(d, 'day %j (wday %w) of %Y') FROM df_demo
----
day 075 (wday 0) of 2020

# %T is the 24-hour HH:MM:SS time.
query
SELECT DATE_FORMAT(d, '%T') FROM df_demo
----
09:07:42

# %U is the Sunday-first week number (mode 0): 2020-01-05 is the first Sunday so
# week 01, the day before is week 00.
query
SELECT DATE_FORMAT('2020-01-05', '%U'), DATE_FORMAT('2020-01-04', '%U')
----
01	00

# %v is the Monday-first ISO week number (mode 3): 2020-01-06 starts ISO week 02,
# and 2021-01-01 belongs to ISO week 53 of the prior year.
query
SELECT DATE_FORMAT('2020-01-06', '%v'), DATE_FORMAT('2021-01-01', '%v')
----
02	53
