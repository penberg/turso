# DATE_FORMAT(d, fmt) conformance.
#
# MySQL's DATE_FORMAT formats a datetime with format specifiers. The front-end
# lowers it to strftime() for the directly-translatable specifiers -- %Y %m %d
# %H, %i (minutes -> %M), %s (seconds -> %S), %j (day of year), %w (weekday
# number), %U (Sunday-first week), %v (ISO week -> %V), %x (ISO week-year ->
# %G), %T (-> %H:%M:%S), %% --
# and expands the name specifiers (%M month name, %b abbreviated month, %W
# weekday name, %a abbreviated weekday) to CASE lookups, the no-leading-zero
# numeric specifiers (%e day, %c month, %k hour) to integer casts, the week
# numbers %u (Monday-first mode 1) and %V (Sunday-first mode 2) to the WEEK()
# mode lowering zero-padded to two digits, the 12-hour clock (%l no-pad, %h/%I
# padded, %r = hh:mm:ss AM/PM), meridiem (%p), the two-digit year (%y), and the
# day-with-ordinal-suffix %D to CASE / strftime expressions, concatenating the
# pieces. Literal characters pass through. The format must be a string literal;
# specifiers without any of these forms (%X and microseconds %f) are rejected.
# See mysql/COMPAT.md.
#
# Expected to pass against both turso-mysql-server and a real mysqld.

statement ok
CREATE TABLE IF NOT EXISTS df_demo (a INT PRIMARY KEY, d DATETIME)

statement ok
INSERT INTO df_demo (a, d) VALUES (1, '2020-03-15 09:07:42')

# Reconstruct the standard datetime string (%i/%s map to minutes/seconds).
query
SELECT DATE_FORMAT(d, '%Y-%m-%d %H:%i:%s') FROM df_demo
----
2020-03-15 09:07:42

# Custom separators and literal text are copied verbatim.
query
SELECT DATE_FORMAT(d, 'Y=%Y M=%m D=%d') FROM df_demo
----
Y=2020 M=03 D=15

# A literal percent (%%).
query
SELECT DATE_FORMAT(d, '%H%%') FROM df_demo
----
09%

# %j is the day of year, 3-digit zero-padded (2020-03-15 is day 075).
query
SELECT DATE_FORMAT(d, '%j') FROM df_demo
----
075

# %j at the year boundaries.
query
SELECT DATE_FORMAT('2021-01-01', '%j'), DATE_FORMAT('2021-12-31', '%j')
----
001	365

# %w is the weekday number, 0=Sunday..6=Saturday (2020-03-15 is a Sunday).
query
SELECT DATE_FORMAT(d, '%w') FROM df_demo
----
0

query
SELECT DATE_FORMAT('2020-03-16', '%w'), DATE_FORMAT('2020-03-21', '%w')
----
1	6

# %j and %w compose with literal text and other specifiers.
query
SELECT DATE_FORMAT(d, 'day %j (wday %w) of %Y') FROM df_demo
----
day 075 (wday 0) of 2020

# %T is the 24-hour HH:MM:SS time.
query
SELECT DATE_FORMAT(d, '%T') FROM df_demo
----
09:07:42

# %U is the Sunday-first week number (mode 0): 2020-01-05 is the first Sunday so
# week 01, the day before is week 00.
query
SELECT DATE_FORMAT('2020-01-05', '%U'), DATE_FORMAT('2020-01-04', '%U')
----
01	00

# %v is the Monday-first ISO week number (mode 3): 2020-01-06 starts ISO week 02,
# and 2021-01-01 belongs to ISO week 53 of the prior year.
query
SELECT DATE_FORMAT('2020-01-06', '%v'), DATE_FORMAT('2021-01-01', '%v')
----
02	53

# %x is the year of the %v (ISO 8601) week, so it follows the week across a year
# boundary: 2021-01-01 is in ISO week 53 of 2020 (%x = 2020), and 2023-01-01 is
# in week 52 of 2022 (%x = 2022). It pairs with %v to form an ISO year-week.
query
SELECT DATE_FORMAT('2021-01-01', '%x'), DATE_FORMAT('2023-01-01', '%x'), DATE_FORMAT('2026-06-15', '%x-W%v')
----
2020	2022	2026-W25

# %u is the Monday-first week, mode 1 (00..53) -- like WEEK(d, 1) -- zero-padded
# to two digits, and %V is the Sunday-first week, mode 2 (01..53), like
# WEEK(d, 2). Both differ from the %U/%v already covered above.
query
SELECT DATE_FORMAT('2020-06-15', '%u'), DATE_FORMAT('2020-06-15', '%V')
----
25	24

# Their year-boundary behavior: %u is 00 for a leading partial week (2021-01-01,
# 2023-01-01) and 53 at the end of 2020; %V renumbers a leading partial week as
# the previous year's last (52).
query
SELECT DATE_FORMAT('2021-01-01', '%u'), DATE_FORMAT('2023-01-01', '%u'), DATE_FORMAT('2020-12-31', '%u')
----
00	00	53

query
SELECT DATE_FORMAT('2021-01-01', '%V'), DATE_FORMAT('2020-01-01', '%V'), DATE_FORMAT('2023-01-01', '%V')
----
52	52	01

# All four week specifiers compose in one format (Sunday/Monday x 0-53/1-53).
query
SELECT DATE_FORMAT('2020-06-15', '%U/%u/%V/%v'), DATE_FORMAT(NULL, '%u')
----
24/25/24/25	NULL

# %M is the full month name, %W the full weekday name (2020-03-15 is a Sunday in
# March). These have no strftime form and expand to CASE lookups.
query
SELECT DATE_FORMAT(d, '%W, %M %d, %Y') FROM df_demo
----
Sunday, March 15, 2020

# %b is the abbreviated month, %a the abbreviated weekday.
query
SELECT DATE_FORMAT(d, '%a %b %d') FROM df_demo
----
Sun Mar 15

# A name specifier alone, and names across the calendar.
query
SELECT DATE_FORMAT('2020-01-01', '%M'), DATE_FORMAT('2020-12-31', '%W')
----
January	Thursday

# A NULL date still propagates through the concatenated name lowering.
query
SELECT DATE_FORMAT(NULL, '%W %M')
----
NULL

# %e (day), %c (month), %k (hour) are the no-leading-zero numeric forms.
query
SELECT DATE_FORMAT('2020-03-05 09:07:42', '%e'), DATE_FORMAT('2020-03-05', '%c'), DATE_FORMAT('2020-03-05 09:07:42', '%k')
----
5	3	9

# %d zero-pads but %e does not (contrast on the same day).
query
SELECT DATE_FORMAT('2020-03-05', '%d vs %e')
----
05 vs 5

# Composed into a compact date/time.
query
SELECT DATE_FORMAT('2020-12-25 23:08:00', '%c/%e %k:%i')
----
12/25 23:08

# 12-hour clock with AM/PM (the common WordPress 'g:i a' time format): midnight
# is 12 AM, 13:05 is 1:05 PM, 23:30 is 11:30 PM.
query
SELECT DATE_FORMAT('2020-03-15 00:05:00', '%l:%i %p'), DATE_FORMAT('2020-03-15 13:05:00', '%l:%i %p'), DATE_FORMAT('2020-03-15 23:30:00', '%l:%i %p')
----
12:05 AM	1:05 PM	11:30 PM

# %h / %I are the two-digit padded 12-hour hour (0->12, 9->09, 13->01).
query
SELECT DATE_FORMAT('2020-03-15 00:00:00', '%h'), DATE_FORMAT('2020-03-15 09:00:00', '%h'), DATE_FORMAT('2020-03-15 13:00:00', '%I')
----
12	09	01

# %p alone, at noon (PM) and just before (AM).
query
SELECT DATE_FORMAT('2020-03-15 12:00:00', '%p'), DATE_FORMAT('2020-03-15 11:59:59', '%p')
----
PM	AM

# NULL propagates through the 12-hour and meridiem lowerings.
query
SELECT DATE_FORMAT(NULL, '%l'), DATE_FORMAT(NULL, '%h'), DATE_FORMAT(NULL, '%p')
----
NULL	NULL	NULL

# %D is the day of month with an English ordinal suffix.
query
SELECT DATE_FORMAT('2020-03-01', '%D'), DATE_FORMAT('2020-03-02', '%D'), DATE_FORMAT('2020-03-03', '%D'), DATE_FORMAT('2020-03-04', '%D')
----
1st	2nd	3rd	4th

# The teens (11-13) are all 'th', and the rules resume past them.
query
SELECT DATE_FORMAT('2020-03-11', '%D'), DATE_FORMAT('2020-03-21', '%D'), DATE_FORMAT('2020-03-22', '%D'), DATE_FORMAT('2020-03-31', '%D')
----
11th	21st	22nd	31st

# %D composes with the month name (WordPress 'F jS, Y').
query
SELECT DATE_FORMAT(d, '%M %D, %Y') FROM df_demo
----
March 15th, 2020

query
SELECT DATE_FORMAT(NULL, '%D')
----
NULL

# %y is the two-digit year (the last two digits, zero-padded).
query
SELECT DATE_FORMAT(d, '%y') FROM df_demo
----
20

query
SELECT DATE_FORMAT('2005-01-09', '%y'), DATE_FORMAT('1999-12-31', '%y'), DATE_FORMAT('2026-06-15', '%d/%m/%y')
----
05	99	15/06/26

# %r is the 12-hour hh:mm:ss AM/PM time. Midnight is 12 AM and noon is 12 PM.
query
SELECT DATE_FORMAT(d, '%r') FROM df_demo
----
09:07:42 AM

query
SELECT DATE_FORMAT('2026-06-15 14:05:09', '%r'), DATE_FORMAT('2026-06-15 00:30:00', '%r'), DATE_FORMAT('2026-06-15 12:00:00', '%r')
----
02:05:09 PM	12:30:00 AM	12:00:00 PM

# %y and %r compose with other specifiers and pass NULL through.
query
SELECT DATE_FORMAT('2026-06-15 14:05:09', '%M %D, %y at %r'), DATE_FORMAT(NULL, '%y %r')
----
June 15th, 26 at 02:05:09 PM	NULL

# A long format string packed with the CASE-heavy 12-hour / meridiem specifiers
# (%h %I %l %p %r %T %k) must format correctly without overflowing the engine's
# expression-evaluator stack. The pieces are concatenated as a balanced `||`
# tree so the AST stays shallow regardless of how many specifiers appear.
query
SELECT DATE_FORMAT('2020-06-15 14:05:03', '%h %I %l %p %r %T %k')
----
02 02 2 PM 02:05:03 PM 14:05:03 14

# An even longer mix of name, numeric and clock specifiers still formats and
# keeps NULL propagation.
query
SELECT DATE_FORMAT('2020-06-15 14:05:03', '%Y-%m-%d %H:%i:%s %p %r %T %W %M %j %h'), DATE_FORMAT(NULL, '%h %I %l %p %r %T %k')
----
2020-06-15 14:05:03 PM 02:05:03 PM 14:05:03 Monday June 167 02	NULL
