# Derived tables (subqueries in FROM): `FROM (SELECT ...) alias`. The engine and
# MySQL treat a derived table the same way; MySQL requires the alias, which the
# front-end enforces. The inner select-list names (including aliases) become the
# derived table's columns.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Every
# row-returning query is ORDER BY-deterministic.

statement ok
CREATE TABLE IF NOT EXISTS dt (id INT PRIMARY KEY, grp INT, n INT)

statement ok
INSERT INTO dt (id, grp, n) VALUES (1, 1, 10), (2, 1, 20), (3, 2, 5), (4, 2, 40)

# Derived table with its own WHERE, referenced by alias.
query
SELECT s.id, s.n FROM (SELECT id, n FROM dt WHERE n >= 20) s ORDER BY s.id
----
2	20
4	40

# Derived table that aggregates; the outer query filters its result.
query
SELECT g, total FROM (SELECT grp g, SUM(n) total FROM dt GROUP BY grp) sums WHERE total >= 30 ORDER BY g
----
1	30
2	45

# Outer ORDER BY / LIMIT over a derived table.
query
SELECT n FROM (SELECT n FROM dt) x ORDER BY n DESC LIMIT 2
----
40
20
