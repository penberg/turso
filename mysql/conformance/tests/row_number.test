# ROW_NUMBER() OVER (...) conformance.
#
# MySQL's ROW_NUMBER() window function numbers the rows of each partition 1, 2,
# 3, ... in the window's ORDER BY order. The front-end allows it through to the
# engine's row_number(), which behaves identically; the OVER clause (PARTITION
# BY and ORDER BY) is parsed the same as for a windowed aggregate. The other
# MySQL window functions (RANK, DENSE_RANK, LAG, NTILE, ...) have no engine
# equivalent and stay unsupported.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name and ORDER BY-deterministic queries.

statement ok
CREATE TABLE IF NOT EXISTS rn_demo (id INT PRIMARY KEY, g INT, v INT)

statement ok
INSERT INTO rn_demo (id, g, v) VALUES (1,1,10),(2,1,30),(3,1,20),(4,2,40),(5,2,40),(6,2,5)

# A single ordering numbers every row by ascending v (id breaks ties): the
# smallest v (5, at id 6) is row 1, the largest (40, at id 5) is row 6.
query
SELECT id, ROW_NUMBER() OVER (ORDER BY v, id) FROM rn_demo ORDER BY id
----
1	2
2	4
3	3
4	5
5	6
6	1

# PARTITION BY restarts the numbering within each group.
query
SELECT id, g, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v, id) FROM rn_demo ORDER BY id
----
1	1	1
2	1	3
3	1	2
4	2	2
5	2	3
6	2	1

# Descending order reverses the assignment.
query
SELECT id, ROW_NUMBER() OVER (ORDER BY v DESC, id) FROM rn_demo WHERE g = 1 ORDER BY id
----
1	3
2	1
3	2

# The classic "first row per group" via a derived table: row 1 of each
# partition ordered by v.
query
SELECT id FROM (
  SELECT id, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v, id) AS rk FROM rn_demo
) t
WHERE t.rk = 1
ORDER BY id
----
1
6
