# ROW(...) — MySQL's explicit row constructor.
#
# ROW(e1, e2, ...) builds a row value, identical to the parenthesized tuple
# (e1, e2, ...). The front-end lowers it to the engine's row value, which
# compares element-wise exactly as MySQL compares a ROW(...): equality is
# component-wise, ordering is lexicographic, and a row value works as an IN
# operand and an IN list element. MySQL requires at least two elements.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

# Component-wise equality: equal rows are equal, a single differing component
# makes them unequal.
query
SELECT ROW(1, 2) = ROW(1, 2), ROW(1, 3) = ROW(1, 2), ROW(1, 2, 3) = ROW(1, 2, 3)
----
1	0	1

# Lexicographic ordering compares left to right.
query
SELECT ROW(1, 2) < ROW(1, 3), ROW(2, 0) > ROW(1, 9), ROW(1, 2) <= ROW(1, 2)
----
1	1	1

# A row value as an IN operand, with ROW(...) list elements.
query
SELECT ROW(1, 2) IN (ROW(3, 4), ROW(1, 2)), ROW(9, 9) IN (ROW(3, 4), ROW(1, 2))
----
1	0

# ROW(...) mixes with the literal tuple form — they are the same row value.
query
SELECT ROW(1, 2) = (1, 2), (1, 2) = ROW(1, 2)
----
1	1

# Equal string components compare equal (case-exact strings match on both).
query
SELECT ROW('apple', 1) = ROW('apple', 1), ROW('apple', 1) = ROW('banana', 1)
----
1	0

# Row values over table columns: match rows whose (a, b) tuple equals a target.
statement ok
CREATE TABLE IF NOT EXISTS row_demo (id INT PRIMARY KEY, a INT, b INT)

statement ok
INSERT INTO row_demo (id, a, b) VALUES (1, 10, 20), (2, 10, 30), (3, 40, 20)

query
SELECT id FROM row_demo WHERE ROW(a, b) = ROW(10, 30)
----
2

query
SELECT id FROM row_demo WHERE ROW(a, b) IN (ROW(10, 20), ROW(40, 20)) ORDER BY id
----
1
3
