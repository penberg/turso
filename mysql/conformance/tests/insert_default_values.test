# INSERT ... () VALUES () (all-defaults row) conformance.
#
# MySQL's INSERT INTO t () VALUES () (and the column-list-less INSERT INTO t
# VALUES ()) inserts a single row using every column's default. The front-end
# maps a no-column-list empty row to the engine's DEFAULT VALUES, which applies
# the column defaults the same way. The multi-row form (VALUES (), ()) -- which
# the engine has no single-statement equivalent for -- expands to one DEFAULT
# VALUES insert per row.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

statement ok
CREATE TABLE IF NOT EXISTS idv_demo (id INT PRIMARY KEY AUTO_INCREMENT, n INT DEFAULT 7, s VARCHAR(10) DEFAULT 'def')

# The empty column list / empty values form inserts an all-defaults row.
statement ok
INSERT INTO idv_demo () VALUES ()

# The column-list-less form does the same.
statement ok
INSERT INTO idv_demo VALUES ()

# Both rows carry the column defaults, with the auto-increment id advancing.
query
SELECT id, n, s FROM idv_demo ORDER BY id
----
1	7	def
2	7	def

# Ordinary inserts are unaffected and coexist.
statement ok
INSERT INTO idv_demo (n, s) VALUES (10, 'x')

statement ok
INSERT INTO idv_demo () VALUES ()

query
SELECT id, n, s FROM idv_demo ORDER BY id
----
1	7	def
2	7	def
3	10	x
4	7	def

# Multiple empty rows in one statement each insert an all-defaults row. The
# engine has no multi-row DEFAULT VALUES, so the front-end expands them.
statement ok
CREATE TABLE IF NOT EXISTS idv_multi (id INT PRIMARY KEY AUTO_INCREMENT, n INT DEFAULT 3, s VARCHAR(8) DEFAULT 'm')

statement ok
INSERT INTO idv_multi () VALUES (), (), ()

query
SELECT id, n, s FROM idv_multi ORDER BY id
----
1	3	m
2	3	m
3	3	m

# The column-list-less multi-row form does the same.
statement ok
INSERT INTO idv_multi VALUES (), ()

query
SELECT COUNT(*), MIN(n), MAX(n) FROM idv_multi
----
5	3	3
