# HAVING without GROUP BY conformance.
#
# A HAVING clause with no GROUP BY treats the whole result as a single group and
# filters it by an aggregate condition. The front-end models it as an empty
# GROUP BY carrying the HAVING; the engine evaluates it the same as MySQL,
# returning the aggregate row when the condition holds and no rows otherwise.
#
# The aggregate condition may reference an aggregate through its SELECT-list
# alias (`SELECT COUNT(*) c ... HAVING c > 2`); such a HAVING must stay in place,
# not be folded into WHERE (an aggregate is not allowed there).
#
# MySQL also allows a non-aggregate HAVING with no GROUP BY -- a post-WHERE row
# filter (WordPress's custom-fields query is `SELECT DISTINCT meta_key ... HAVING
# meta_key NOT LIKE '_%'`). The engine rejects a non-aggregate HAVING, so the
# front-end folds it into the WHERE clause, where the filtering is equivalent.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

statement ok
CREATE TABLE IF NOT EXISTS hg_demo (id INT PRIMARY KEY, n INT)

statement ok
INSERT INTO hg_demo (id, n) VALUES (1, 5), (2, 15), (3, 25)

# The single aggregate group passes the condition.
query
SELECT COUNT(*) FROM hg_demo HAVING COUNT(*) > 2
----
3

# The condition fails, so no row is returned.
query
SELECT COUNT(*) FROM hg_demo HAVING COUNT(*) > 5
----

# A non-COUNT aggregate condition.
query
SELECT SUM(n) FROM hg_demo HAVING SUM(n) > 40
----
45

# The condition may reference the aggregate through its SELECT-list alias.
query
SELECT COUNT(*) c FROM hg_demo HAVING c > 2
----
3

query
SELECT MAX(n) m FROM hg_demo HAVING m > 20
----
25

# An aggregate-alias condition that fails returns no rows.
query
SELECT COUNT(*) c FROM hg_demo HAVING c > 5
----

# A condition over more than one aggregate alias.
query
SELECT MIN(n) lo, MAX(n) hi FROM hg_demo HAVING hi - lo > 10
----
5	25

# HAVING composes with a WHERE that narrows the group first.
query
SELECT COUNT(*) FROM hg_demo WHERE n >= 15 HAVING COUNT(*) = 2
----
2

# A non-aggregate HAVING is a row filter, folded into WHERE. It selects the
# matching rows individually, not a single aggregate group.
query
SELECT id FROM hg_demo HAVING n > 10 ORDER BY id
----
2
3

# It composes with an existing WHERE (both conditions must hold).
query
SELECT id FROM hg_demo WHERE id <= 2 HAVING n > 10 ORDER BY id
----
2

# The WordPress custom-fields shape: DISTINCT + a HAVING ... NOT LIKE filter.
statement ok
CREATE TABLE IF NOT EXISTS hg_meta (id INT PRIMARY KEY, meta_key VARCHAR(50))

statement ok
INSERT INTO hg_meta (id, meta_key) VALUES (1, 'price'), (2, '_edit_lock'), (3, 'color'), (4, 'price')

query
SELECT DISTINCT meta_key FROM hg_meta HAVING meta_key NOT LIKE '\_%' ORDER BY meta_key
----
color
price
