# Expression operators conformance — arithmetic, IN, BETWEEN, LIKE.
#
# These constructs have identical MySQL and SQLite/turso semantics, so this file
# must pass against both `turso-mysql-server` and a real mysqld. Only integer
# arithmetic with `+ - *` is exercised (`/` and `%` diverge and are not
# supported). Uses its own table name; every query is ORDER BY-deterministic.

statement ok
CREATE TABLE IF NOT EXISTS ops_demo (id INT PRIMARY KEY, name VARCHAR(32), qty INT, price INT)

statement ok
INSERT INTO ops_demo (id, name, qty, price) VALUES (1, 'apple', 3, 10), (2, 'banana', 5, 4), (3, 'cherry', 2, 20), (4, 'date', 10, 2)

# Arithmetic in the select list (integer + - *).
query
SELECT id, qty * price FROM ops_demo ORDER BY id
----
1	30
2	20
3	40
4	20

query
SELECT id, price + 1, price - 1 FROM ops_demo ORDER BY id
----
1	11	9
2	5	3
3	21	19
4	3	1

# Arithmetic and precedence in WHERE.
query
SELECT id FROM ops_demo WHERE qty * price > 25 ORDER BY id
----
1
3

# IN with a value list.
query
SELECT name FROM ops_demo WHERE id IN (1, 3, 4) ORDER BY name
----
apple
cherry
date

# NOT IN.
query
SELECT name FROM ops_demo WHERE id NOT IN (1, 2) ORDER BY name
----
cherry
date

# BETWEEN (inclusive bounds).
query
SELECT name FROM ops_demo WHERE qty BETWEEN 3 AND 5 ORDER BY name
----
apple
banana

# NOT BETWEEN.
query
SELECT name FROM ops_demo WHERE price NOT BETWEEN 5 AND 20 ORDER BY name
----
banana
date

# LIKE with % and _ wildcards (ASCII).
query
SELECT name FROM ops_demo WHERE name LIKE '%a%' ORDER BY name
----
apple
banana
date

query
SELECT name FROM ops_demo WHERE name LIKE '_____' ORDER BY name
----
apple

# NOT LIKE.
query
SELECT name FROM ops_demo WHERE name NOT LIKE 'a%' ORDER BY name
----
banana
cherry
date

# Combined: arithmetic + BETWEEN + AND (BETWEEN's AND must not be swallowed).
query
SELECT id FROM ops_demo WHERE qty BETWEEN 2 AND 5 AND price * 2 > 8 ORDER BY id
----
1
3
