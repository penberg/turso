# SHOW INDEX / SHOW KEYS conformance.
#
# `SHOW {INDEX|INDEXES|KEYS} FROM tbl` lists a table's indexes in MySQL's
# 15-column shape (Table, Non_unique, Key_name, Seq_in_index, Column_name,
# Collation, Cardinality, Sub_part, Packed, Null, Index_type, Comment,
# Index_comment, Visible, Expression). WordPress's dbDelta() reads it -- by
# column name, order-independently -- to learn which indexes already exist.
#
# This is the engine's representation of that output. The engine keeps no index
# statistics, so Cardinality is 0 (as MySQL reports for an unanalyzed/empty table
# and as information_schema.STATISTICS reports), while Sub_part / Packed /
# Expression are NULL; Collation is 'A', Index_type 'BTREE', Visible 'YES'. It is
# NOT byte-identical to a real mysqld only in the row order, which follows the
# engine's PRAGMA order rather than MySQL's PRIMARY-first ordering. The values
# dbDelta keys on (Key_name, Column_name, Non_unique, Seq_in_index) match. The
# PRIMARY KEY is reported under the name PRIMARY with Null=''.

statement ok
CREATE TABLE IF NOT EXISTS si_demo (id INT PRIMARY KEY, email VARCHAR(40), tag VARCHAR(20) NOT NULL)

statement ok
CREATE UNIQUE INDEX si_email_u ON si_demo (email)

statement ok
CREATE INDEX si_tag_idx ON si_demo (tag)

# Non-unique key on a NOT NULL column, unique key on a nullable column, and the
# primary key (reported as PRIMARY, Null='').
query
SHOW INDEX FROM si_demo
----
si_demo	1	si_tag_idx	1	tag	A	0	NULL	NULL		BTREE			YES	NULL
si_demo	0	si_email_u	1	email	A	0	NULL	NULL	YES	BTREE			YES	NULL
si_demo	0	PRIMARY	1	id	A	0	NULL	NULL		BTREE			YES	NULL

# SHOW KEYS is a synonym.
query
SHOW KEYS FROM si_demo
----
si_demo	1	si_tag_idx	1	tag	A	0	NULL	NULL		BTREE			YES	NULL
si_demo	0	si_email_u	1	email	A	0	NULL	NULL	YES	BTREE			YES	NULL
si_demo	0	PRIMARY	1	id	A	0	NULL	NULL		BTREE			YES	NULL

# A compound unique index reports one row per column, in key order.
statement ok
CREATE UNIQUE INDEX si_pair ON si_demo (email, tag)

query
SHOW INDEX FROM si_demo
----
si_demo	0	si_pair	1	email	A	0	NULL	NULL	YES	BTREE			YES	NULL
si_demo	0	si_pair	2	tag	A	0	NULL	NULL		BTREE			YES	NULL
si_demo	1	si_tag_idx	1	tag	A	0	NULL	NULL		BTREE			YES	NULL
si_demo	0	si_email_u	1	email	A	0	NULL	NULL	YES	BTREE			YES	NULL
si_demo	0	PRIMARY	1	id	A	0	NULL	NULL		BTREE			YES	NULL

# SHOW INDEX on a missing table errors (MySQL 1146).
statement error
SHOW INDEX FROM no_such_table
