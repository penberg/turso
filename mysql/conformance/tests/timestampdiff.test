# TIMESTAMPDIFF(unit, a, b) conformance.
#
# MySQL's TIMESTAMPDIFF(unit, a, b) is b - a expressed in whole `unit`s -- note
# the operand order is the reverse of DATEDIFF. The front-end supports the
# fixed-duration units (SECOND, MINUTE, HOUR, DAY, WEEK) by dividing the
# epoch-second difference unixepoch(b) - unixepoch(a) by the unit length;
# SQLite's integer division truncates toward zero, matching MySQL's
# "complete units" result for both signs. The calendar units MONTH, QUARTER, and
# YEAR count whole months (year*12 + month, minus one when the trailing month is
# incomplete) and scale by 1 / 3 / 12. NULL propagates.
#
# Scope: MICROSECOND is rejected by the front-end (the engine's datetimes carry
# only millisecond precision); that is covered by a parser unit test, not here,
# because a real mysqld accepts it.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name and ORDER BY-deterministic queries.

statement ok
CREATE TABLE IF NOT EXISTS tsd_demo (a INT PRIMARY KEY, d1 DATETIME, d2 DATETIME)

statement ok
INSERT INTO tsd_demo (a, d1, d2) VALUES
  (1, '2020-01-01 00:00:00', '2020-01-03 00:00:00'),
  (2, '2020-01-01 13:30:00', '2020-01-01 00:00:00'),
  (3, '2020-01-01 00:00:00', '2020-01-01 00:00:00')

# DAY differences, including a negative one (b is before a).
query
SELECT a, TIMESTAMPDIFF(DAY, d1, d2) FROM tsd_demo ORDER BY a
----
1	2
2	0
3	0

# Whole units truncate toward zero for both signs (13h30m -> 13, -13h30m -> -13).
query
SELECT TIMESTAMPDIFF(HOUR, '2020-01-01 00:00:00', '2020-01-01 13:30:00'),
       TIMESTAMPDIFF(HOUR, '2020-01-01 13:30:00', '2020-01-01 00:00:00')
----
13	-13

# A sub-unit remainder is dropped (1 minute 59 seconds is 1 whole minute).
query
SELECT TIMESTAMPDIFF(MINUTE, '2020-01-01 00:00:00', '2020-01-01 00:01:59'),
       TIMESTAMPDIFF(SECOND, '2020-01-01 00:00:00', '2020-01-01 00:00:05')
----
1	5

# WEEK is seven days; 19 days is 2 whole weeks.
query
SELECT TIMESTAMPDIFF(WEEK, '2020-01-01', '2020-01-20')
----
2

# NULL in either datetime yields NULL.
query
SELECT TIMESTAMPDIFF(DAY, NULL, '2020-01-03'), TIMESTAMPDIFF(DAY, '2020-01-01', NULL)
----
NULL	NULL

# Usable in a WHERE predicate.
query
SELECT a FROM tsd_demo WHERE TIMESTAMPDIFF(DAY, d1, d2) > 0 ORDER BY a
----
1

# MONTH counts whole months: a span of 29 months and a bit, and a partial
# trailing month that is dropped because the day-of-month has not been reached
# (Jan 15 -> Feb 10 is 0 months, but Jan 15 -> Feb 20 is 1).
query
SELECT TIMESTAMPDIFF(MONTH, '2024-01-15 08:00:00', '2026-06-20 14:30:00'),
       TIMESTAMPDIFF(MONTH, '2024-01-15', '2024-02-10'),
       TIMESTAMPDIFF(MONTH, '2024-01-15', '2024-02-20')
----
29	0	1

# A negative span is pulled toward zero the same way, and the time-of-day breaks
# a same-day tie (09:00 has not yet reached 10:00, so it is 0 months).
query
SELECT TIMESTAMPDIFF(MONTH, '2026-06-20', '2024-01-15'),
       TIMESTAMPDIFF(MONTH, '2024-06-15 10:00:00', '2024-06-15 09:00:00')
----
-29	0

# End-of-month and leap-day boundaries (values from MySQL 8.4): Mar 31 -> Mar 30
# next year is 11 months (the 31st is not reached), Mar 31 -> Mar 31 is 12, and
# Feb 29 -> Feb 28 a year later is 11.
query
SELECT TIMESTAMPDIFF(MONTH, '2024-03-31', '2025-03-30'),
       TIMESTAMPDIFF(MONTH, '2024-03-31', '2025-03-31'),
       TIMESTAMPDIFF(MONTH, '2020-02-29', '2021-02-28')
----
11	12	11

# QUARTER and YEAR scale the whole-month count by 3 and 12 (truncating toward
# zero): 29 months is 9 quarters and 2 years.
query
SELECT TIMESTAMPDIFF(QUARTER, '2024-01-15 08:00:00', '2026-06-20 14:30:00'),
       TIMESTAMPDIFF(YEAR, '2024-01-15 08:00:00', '2026-06-20 14:30:00'),
       TIMESTAMPDIFF(YEAR, '2024-03-31', '2025-03-30')
----
9	2	0

# NULL propagates through the calendar units too.
query
SELECT TIMESTAMPDIFF(MONTH, NULL, '2026-01-01'), TIMESTAMPDIFF(YEAR, '2026-01-01', NULL)
----
NULL	NULL
