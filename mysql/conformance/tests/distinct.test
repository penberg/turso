# SELECT DISTINCT conformance.
#
# `SELECT DISTINCT` has identical MySQL and SQLite/turso semantics, so this file
# must pass against both `turso-mysql-server` and a real mysqld. DISTINCT does
# not guarantee ordering, so every query uses ORDER BY for determinism. Uses its
# own table name.

statement ok
CREATE TABLE IF NOT EXISTS distinct_demo (id INT PRIMARY KEY, cat VARCHAR(8), n INT)

statement ok
INSERT INTO distinct_demo (id, cat, n) VALUES (1, 'a', 10), (2, 'a', 10), (3, 'b', 10), (4, 'b', 20), (5, 'c', 20)

# DISTINCT on a single column collapses duplicates.
query
SELECT DISTINCT cat FROM distinct_demo ORDER BY cat
----
a
b
c

query
SELECT DISTINCT n FROM distinct_demo ORDER BY n
----
10
20

# DISTINCT over a multi-column projection deduplicates whole rows.
query
SELECT DISTINCT cat, n FROM distinct_demo ORDER BY cat, n
----
a	10
b	10
b	20
c	20

# DISTINCT combined with a WHERE filter.
query
SELECT DISTINCT cat FROM distinct_demo WHERE n = 10 ORDER BY cat
----
a
b
