# Unary minus / plus on an expression.
#
# MySQL negates any expression with a leading `-` (and `+` is the identity).
# The front-end only folded the sign into a numeric *literal* (`-5`), so unary
# minus on a column, function call, or parenthesized expression -- `-a`,
# `-ABS(x)`, `-(a + 1)`, `ABS(-a)`, `ORDER BY -a` -- was a syntax error. It now
# parses as a unary operator at the usual tight precedence.
#
# Expected to pass against both turso-mysql-server and a real mysqld. Uses its
# own table name.

statement ok
CREATE TABLE IF NOT EXISTS um (id INT PRIMARY KEY, a INT)

statement ok
INSERT INTO um (id, a) VALUES (1, 5), (2, 12), (3, -3)

# Negating a column, a function call, and a parenthesized expression.
query
SELECT id, -a, -ABS(a), -(a + 1) FROM um ORDER BY id
----
1	-5	-5	-6
2	-12	-12	-13
3	3	-3	2

# Negation inside a function argument; a double negative; unary plus.
query
SELECT ABS(-a), - -a, +a FROM um WHERE id = 1
----
5	5	5

# Unary minus binds tighter than `*` (so `-a * 2` is `(-a) * 2`) and composes
# with binary minus (`2 - -a`).
query
SELECT -a * 2, 2 - -a FROM um WHERE id = 1
----
-10	7

# `ORDER BY -a` sorts by the negated value (descending by a).
query
SELECT id FROM um ORDER BY -a
----
2
1
3

# A signed numeric literal still works (folded into the literal).
query
SELECT -5, -5.5, a * -1 FROM um WHERE id = 1
----
-5	-5.5	-5
