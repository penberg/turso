# DROP TABLE conformance — the basic form plus `IF EXISTS`.
#
# Implemented by the Turso front-end, so this file is expected to pass against
# both `turso-mysql-server` and a real mysqld. The plain `DROP TABLE tbl_name`
# and `DROP TABLE IF EXISTS tbl_name` forms are supported; TEMPORARY / multiple
# tables / RESTRICT / CASCADE are not (see mysql/COMPAT.md).

statement ok
CREATE TABLE IF NOT EXISTS drop_me (id INT PRIMARY KEY, name VARCHAR(32))

# Basic drop of an existing table succeeds.
statement ok
DROP TABLE drop_me

# Dropping a table that no longer exists is an error (no IF EXISTS).
statement error
DROP TABLE drop_me

# `IF EXISTS` makes dropping a non-existent table a no-op success, exactly as
# MySQL does (it emits a note, not an error).
statement ok
DROP TABLE IF EXISTS drop_me

# `IF EXISTS` also drops the table when it does exist.
statement ok
CREATE TABLE IF NOT EXISTS drop_me_too (id INT PRIMARY KEY)

statement ok
DROP TABLE IF EXISTS drop_me_too

# After the IF EXISTS drop, the table is gone: a plain drop now errors.
statement error
DROP TABLE drop_me_too

# Unsupported sub-clauses are rejected by the front-end. On real MySQL these are
# valid, so they are intentionally NOT exercised here to keep the file green on
# both targets; their rejection is covered by the parser's unit tests.
