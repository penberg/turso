# DATE_ADD / DATE_SUB with INTERVAL conformance.
#
# MySQL's DATE_ADD(d, INTERVAL n unit) / DATE_SUB(d, INTERVAL n unit) shift a
# datetime by an interval. The front-end lowers them to the engine's
# datetime(d, '+n unit') / datetime(d, '-n unit') modifier. On DATETIME values
# both targets return 'YYYY-MM-DD HH:MM:SS'.
#
# Scope: the interval amount may be an integer literal or a quoted numeric
# string (`INTERVAL '30' SECOND`, which WordPress emits and MySQL coerces).
# MONTH/YEAR/QUARTER arithmetic that overflows a shorter month is clamped to that
# month's last day, as in MySQL (the engine would otherwise roll into the next
# month). The one remaining divergence, avoided here, is that on a bare DATE
# value MySQL returns a DATE (no time) while the engine keeps the `00:00:00`
# time, so the clamp cases below use DATETIME inputs (see mysql/COMPAT.md).
#
# Expected to pass against both turso-mysql-server and a real mysqld.

statement ok
CREATE TABLE IF NOT EXISTS dt_demo (a INT PRIMARY KEY, d DATETIME)

statement ok
INSERT INTO dt_demo (a, d) VALUES (1, '2020-01-31 10:20:30')

# Add days.
query
SELECT DATE_ADD(d, INTERVAL 5 DAY) FROM dt_demo
----
2020-02-05 10:20:30

# Add hours, crossing midnight into the next day.
query
SELECT DATE_ADD(d, INTERVAL 14 HOUR) FROM dt_demo
----
2020-02-01 00:20:30

# Subtract days.
query
SELECT DATE_SUB(d, INTERVAL 1 DAY) FROM dt_demo
----
2020-01-30 10:20:30

# A WEEK interval is seven days.
query
SELECT DATE_ADD('2020-03-01 00:00:00', INTERVAL 1 WEEK)
----
2020-03-08 00:00:00

# Mid-month MONTH arithmetic (no month-end clamping involved).
query
SELECT DATE_ADD('2020-01-15 08:00:00', INTERVAL 2 MONTH)
----
2020-03-15 08:00:00

# A quoted numeric string is accepted as the interval amount, exactly as
# WordPress emits it (e.g. its transient-expiry probes use INTERVAL '30' SECOND).
query
SELECT DATE_ADD(d, INTERVAL '30' SECOND) FROM dt_demo
----
2020-01-31 10:21:00

# The string form works for DATE_SUB too.
query
SELECT DATE_SUB(d, INTERVAL '5' DAY) FROM dt_demo
----
2020-01-26 10:20:30

# Month-end clamping (DATETIME inputs, so the result is DATETIME on both): a step
# that overflows a shorter month lands on that month's last day, keeping the
# time. Jan 31 + 1 month is Feb 28, not the rolled-over March.
query
SELECT DATE_ADD('2026-01-31 10:30:45', INTERVAL 1 MONTH), DATE_ADD('2026-03-31 00:00:00', INTERVAL 1 MONTH)
----
2026-02-28 10:30:45	2026-04-30 00:00:00

# DATE_SUB clamps the same way, and a leap day clamps when the target year is not
# a leap year.
query
SELECT DATE_SUB('2026-03-31 12:00:00', INTERVAL 1 MONTH), DATE_ADD('2024-02-29 08:00:00', INTERVAL 1 YEAR)
----
2026-02-28 12:00:00	2025-02-28 08:00:00

# QUARTER (three months) and a multi-year month count clamp too.
query
SELECT DATE_ADD('2026-01-31 09:00:00', INTERVAL 1 QUARTER), DATE_ADD('2026-01-30 06:00:00', INTERVAL 13 MONTH)
----
2026-04-30 09:00:00	2027-02-28 06:00:00

# A step that does not overflow is unchanged (no clamping).
query
SELECT DATE_ADD('2026-01-15 10:00:00', INTERVAL 1 MONTH), DATE_ADD('2026-05-31 23:59:59', INTERVAL 1 MONTH)
----
2026-02-15 10:00:00	2026-06-30 23:59:59

# The `date + INTERVAL` / `date - INTERVAL` operator forms clamp identically.
query
SELECT '2026-01-31 10:00:00' + INTERVAL 1 MONTH, '2026-03-31 10:00:00' - INTERVAL 1 MONTH
----
2026-02-28 10:00:00	2026-02-28 10:00:00

# NULL propagates through the clamp.
query
SELECT DATE_ADD(NULL, INTERVAL 1 MONTH), DATE_ADD(NULL, INTERVAL 1 YEAR)
----
NULL	NULL
